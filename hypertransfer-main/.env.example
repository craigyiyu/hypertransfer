# 复制为 .env 后按需修改;不改也能跑(用下面的默认值)

# 前端对外暴露的端口(宿主机端口)。默认 8080,如已被占用改成别的
WEB_PORT=8080

# 生产环境必须收窄到正式域名;本地 demo 可保留 *
HT_ALLOWED_ORIGINS=*

# 短信网关配置。本地 demo 默认使用 QA 网关;生产请改为正式短信网关
SMS_API_URL=https://hv-test.hypervelocity.cn/api/sms/simpleSend
SMS_SIGN_CN=【武汉极数信息技术】
SMS_SIGN_INTL=[Hypervelocity]

# Sumsub provider integration. Keep token/secret out of git.
# Create these in Sumsub Cockpit Dev Space / Sandbox mode first.
SUMSUB_BASE_URL=https://api.sumsub.com
SUMSUB_ENVIRONMENT=sandbox
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET_KEY=
SUMSUB_KYC_LEVEL_NAME=idv-and-phone-verification
SUMSUB_TR_LEVEL_NAME=travel-rule-basic
SUMSUB_WEBSDK_TTL=600

# Staff RBAC：种子一个后台 admin 账号（首登改密 + 强制 2FA 待后续 PR）。两者留空则不创建。
HT_ADMIN_EMAIL=
HT_ADMIN_PASSWORD=
