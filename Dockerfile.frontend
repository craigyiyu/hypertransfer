# ---- build stage: npm workspaces monorepo -> Next 静态导出(apps/web/out) ----
FROM node:22-slim AS build

WORKDIR /app

ARG NEXT_PUBLIC_APP_VERSION=""
ARG NEXT_PUBLIC_GIT_COMMIT="local"
ENV NEXT_PUBLIC_APP_VERSION=${NEXT_PUBLIC_APP_VERSION}
ENV NEXT_PUBLIC_GIT_COMMIT=${NEXT_PUBLIC_GIT_COMMIT}

# 先装依赖(需要全部 workspace 的 package.json + 根 lockfile; npm ci 依赖 lockfile 完整)
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/
COPY apps/operator/package.json apps/operator/
COPY packages/ui/package.json packages/ui/
COPY packages/eslint-config/package.json packages/eslint-config/
COPY packages/typescript-config/package.json packages/typescript-config/
RUN npm ci

# 再 copy 源码并构建(仅 web 应用; 产物在 apps/web/out)
COPY apps/web apps/web
COPY packages/ui/src packages/ui/src
COPY packages/ui/postcss.config.mjs packages/ui/
COPY packages/ui/tsconfig.json packages/ui/
COPY packages/eslint-config packages/eslint-config
COPY packages/typescript-config packages/typescript-config
RUN npm run build --workspace=web

# ---- runtime stage: nginx 提供静态文件 + 反代 /api ----
FROM nginx:1.27-alpine

COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web/out /usr/share/nginx/html

EXPOSE 80
