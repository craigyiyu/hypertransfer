# 复制为 .env 后按需修改;不改也能跑(用下面的默认值)

# 前端对外暴露的端口(宿主机端口)。默认 8080,如已被占用改成别的
WEB_PORT=8080

# 生产环境必须收窄到正式域名;本地 demo 可保留 *
HT_ALLOWED_ORIGINS=*

# 短信网关配置。本地 demo 默认使用 QA 网关;生产请改为正式短信网关
SMS_API_URL=https://hv-test.hypervelocity.cn/api/sms/simpleSend
SMS_SIGN_CN=【武汉极数信息技术】
SMS_SIGN_INTL=[Hypervelocity]

# Sumsub provider integration. Keep token/secret out of git.
# Create these in Sumsub Cockpit Dev Space / Sandbox mode first.
SUMSUB_BASE_URL=https://api.sumsub.com
SUMSUB_ENVIRONMENT=sandbox
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET_KEY=
SUMSUB_KYC_LEVEL_NAME=idv-and-phone-verification
SUMSUB_TR_LEVEL_NAME=travel-rule-basic
SUMSUB_WEBSDK_TTL=600

# Staff RBAC：种子一个后台 admin 账号（首登改密 + 强制 2FA 待后续 PR）。两者留空则不创建。
HT_ADMIN_EMAIL=
HT_ADMIN_PASSWORD=

# 演示旁路：=true 时 /login/verify 接受任意 6 位码（免去演示现场取 TOTP，2FA 页照样展示）。
# ⚠️ 仅非生产生效；SUMSUB_ENVIRONMENT=production 时即便置 true 也被强制忽略。生产务必留空。
HT_DEMO_BYPASS_2FA=

# 邮件投递（Email OTP / 邀请链接）。SMTP_HOST 留空 → console 占位（演示态）;
# 生产填真实 SMTP/SES/SendGrid 中继。上线前必接（邀请制 + Email OTP 都依赖）。
EMAIL_FROM=no-reply@hypercypto.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# 入金编排（②KYC 硬阻断 + ③真实发址）。network→Hex Safe chainId 映射，默认 sandbox testnet,
# 上 mainnet 时覆盖（ethereum→1、tron→tron）。Forex 结算法币与参考汇率为 ④ demo（无真实 OTC API）。
HEXSAFE_CHAIN_ETHEREUM=11155111
HEXSAFE_CHAIN_TRON=tron:nile
DEPOSIT_FIAT_CURRENCY=HKD
DEPOSIT_FIAT_RATE=7.8

# Hex Safe (Hex Trust) custody integration —— 发址/到账查询/提现。私钥/Key 不入 git。
# 未配置(留空)时 /api/hexsafe/* 返回 503，认证 API 仍可独立启动。
# API_KEY 与私钥二选一: 给 PEM 内容(HEXSAFE_PRIVATE_KEY) 或 文件路径(HEXSAFE_PRIVATE_KEY_PATH)。
HEXSAFE_API_KEY=
HEXSAFE_PRIVATE_KEY=
HEXSAFE_PRIVATE_KEY_PATH=
HEXSAFE_BASE_URL=https://api.sandbox.hexsafe.hextrust.com
HEXSAFE_API_PREFIX=/v1
# 默认 WTA vault 与 enterprise（发址/提现的默认值，端点也可显式传）
HEXSAFE_VAULT_ID=
HEXSAFE_ENTERPRISE_ID=
